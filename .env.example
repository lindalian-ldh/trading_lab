# 复制为 .env 并按需修改
# AI 配置（默认关闭）
AI_ENABLED=false
AI_API_KEY=your_api_key_here
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-v4-flash-vision-exp

# 交易所
EXCHANGE=binance
DEFAULT_SYMBOL=BTC/USDT

# 日志级别
LOG_LEVEL=INFO

# 板块扫描 zzshare API token（免费申请：https://quant.zizizaizai.com/me/profile）
ZZSHARE_TOKEN=your_zzshare_token_here
